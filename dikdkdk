local A = {
    on = false, was_dead = false, cfg_t = 0, force_t = 0, sig = nil, lsig = nil, ang_dirty = true,
    cyc = 0, since = 0, ch = 0, ch_prev = 0, ch_last = nil, stuck = 0, own = 0, force_cycle = true,
    inv = false, lim = 58, brute = false, rnd = false, next_flip = 0, next_lim = 0,
    last_hp = nil, last_flip_t = 0, hit_t = 0, hits_recent = 0, panic_t = 0, hit_flag = false,
    flick = false, next_flick = 0, sw = false, want = 1, tgt = nil, tgt_bad = 0, capped = false,
    ap_inv = nil, ap_lim = nil, ap_lag_en = nil, ap_lag_lim = nil, ap_amt = nil,
    amt_eff = nil, next_amt = 0, tw = nil, tw_t = 0, err = "",
}
local cfg = { en = false }
local sway_fn, sway_k, sway_a

local function load_cfg()
    cfg.en       = U.en:get() and true or false
    cfg.pitch    = U.pitch:get()
    cfg.base     = U.base:get()
    cfg.mod      = U.mod:get()
    cfg.amt      = U.amt:get()
    cfg.spd      = U.spd:get()
    cfg.mrand    = U.mrand:get() and true or false
    cfg.fake     = U.fake:get() and true or false
    cfg.limit    = U.limit:get()
    cfg.rand     = U.rand:get() and true or false
    cfg.lmin     = U.lmin:get()
    cfg.lbias    = U.lbias:get()
    cfg.inv_mode = U.inv_mode:get()
    cfg.inv_per  = max(1, floor(U.inv_per:get()))
    cfg.inv_rnd  = U.inv_rnd:get()
    cfg.lag      = U.lag:get() and true or false
    cfg.lag_mode = U.lag_mode:get()
    cfg.lag_n    = floor(U.lag_n:get())
    cfg.lag_v    = U.lag_v:get()
    cfg.lag_cap  = U.lag_cap:get() and true or false
    cfg.def      = U.def:get() and true or false
    cfg.def_ev   = floor(U.def_ev:get())
    local sig = tostring(cfg.pitch) .. "|" .. tostring(cfg.base) .. "|" .. tostring(cfg.mod) .. "|"
        .. tostring(cfg.amt) .. "|" .. tostring(cfg.spd) .. "|" .. tostring(cfg.mrand) .. "|" .. tostring(cfg.fake)
    if sig ~= A.sig then A.sig = sig; A.ang_dirty = true; A.amt_eff = nil; A.next_amt = 0 end
    local lsig = tostring(cfg.lag) .. "|" .. tostring(cfg.lag_n) .. "|" .. tostring(cfg.lag_mode)
    if lsig ~= A.lsig then A.lsig = lsig; A.ap_lag_en, A.ap_lag_lim = nil, nil; A.tgt_bad, A.capped = 0, false end
end

local function roll_period(base, var)
    local p = base * (1 + (random() * 2 - 1) * var / 100)
    return max(1, round(p))
end

-- ---------- каналы ----------
local function apply_modifier()
    local m, amt = cfg.mod, cfg.amt
    if cfg.mrand and A.amt_eff and m ~= "Spin" then amt = A.amt_eff end
    A.ap_amt = amt
    if m == "Sway" then
        if not sway_fn or sway_k ~= cfg.spd or sway_a ~= amt then
            sway_k, sway_a = cfg.spd, amt
            local k, a = cfg.spd * 0.1, amt
            sway_fn = function(t, by) return sin(t * k) * a end
        end
        acall("override_yaw_modifier", sway_fn)
    elseif m == "Disabled" then
        acall("override_yaw_modifier", "Disabled")
    else
        acall("override_yaw_modifier", m, amt)
    end
end

local function apply_angles()
    A.ang_dirty = false
    if not A.flick then
        acall("override_pitch", cfg.pitch)
        acall("override_yaw_offset", 0)
    end
    acall("override_yaw", cfg.base, "camera")
    apply_modifier()
    acall("override_body_yaw", true)
    acall("override_show_fake", cfg.fake)
end

local function next_lag()
    local L, m = cfg.lag_n, cfg.lag_mode
    if m == "Maximum" then return L end
    if m == "Fluctuate" then return random(max(1, round(L * (1 - cfg.lag_v / 100))), L) end
    if m == "Random" then return random(1, L) end
    -- Adaptive: в воздухе / на бегу длинный лаг, на месте короткий
    local spd, ground = 0, true
    local ok1, s1 = pcall(movement.get_speed)
    if ok1 and type(s1) == "number" then spd = s1 end
    local ok2, g2 = pcall(movement.is_grounded)
    if ok2 and g2 == false then ground = false end
    if not ground then return L end
    if spd > 6 then return random(max(1, round(L * 0.6)), L) end
    return random(max(1, round(L / 4)), max(2, round(L / 2)))
end

local function end_flick()
    if A.flick then
        A.flick = false
        acall("override_pitch", cfg.pitch)
        acall("override_yaw_offset", 0)
    end
end

-- попали по нам -> меняем сторону (проверка каждый тик)
local function check_hit(rt)
    if cfg.inv_mode ~= "Anti-Brute" then A.last_hp = nil return end
    local me = ME.me
    if me == nil then return end
    local hp = entity.get_player_health(me)
    if type(hp) ~= "number" then return end
    if A.last_hp and hp < A.last_hp and hp > 0 and (rt - A.last_flip_t) > 0.12 then
        A.brute = not A.brute
        A.last_flip_t = rt
        A.hit_flag = true
        A.next_lim = 0
        if rt - A.hit_t < 3 then A.hits_recent = A.hits_recent + 1 else A.hits_recent = 1 end
        A.hit_t = rt
        if A.hits_recent >= 2 then A.panic_t = rt + 3 end        -- бьют по паттерну: 3 с рандома
    end
    A.last_hp = hp
end

-- начало нового цикла choke (= новый реально отправляемый пакет)
local function new_cycle(rt, tk)
    A.cyc = A.cyc + 1
    A.since = 0

    -- 1) fake lag
    if cfg.lag and cfg.lag_n >= 1 then
        if A.ap_lag_en ~= true then
            A.ap_lag_en = true
            acall("override_fake_lag", true)
            acall("override_fake_lag_variability", 0)       -- разброс делаем сами
            A.ap_lag_lim = nil
        end
        A.want = round(next_lag())
        if A.ap_lag_lim ~= A.want then A.ap_lag_lim = A.want; acall("override_fake_lag_limit", A.want) end
    else
        if A.ap_lag_en ~= false then A.ap_lag_en = false; acall("override_fake_lag", false) end
        A.want = 1
    end

    -- 2) inverter
    local mode   = cfg.inv_mode
    local manual = U.inv_key:get() and true or false
    local inv
    if mode == "Static" then
        inv = manual
    elseif mode == "Jitter" then
        inv = ((floor(A.cyc / cfg.inv_per) % 2) == 1) ~= manual
    elseif mode == "Random" then
        if A.cyc >= A.next_flip then
            A.rnd = not A.rnd
            A.next_flip = A.cyc + roll_period(cfg.inv_per, cfg.inv_rnd)
        end
        inv = (A.rnd ~= manual)
    else -- Anti-Brute
        if rt < A.panic_t then
            if A.cyc >= A.next_flip then
                A.rnd = not A.rnd
                A.next_flip = A.cyc + roll_period(max(floor(cfg.inv_per / 2), 1), 60)
            end
            inv = (A.rnd ~= manual)
        else
            inv = (A.brute ~= manual)
        end
    end
    local flipped = (inv ~= A.inv)
    A.inv = inv

    -- 3) лимит desync (бросок смещён к максимуму)
    local maxl, lim = cfg.limit, nil
    if cfg.rand then
        local mn = min(cfg.lmin, maxl)
        if flipped or A.cyc >= A.next_lim or A.lim > maxl or A.lim < mn then
            local u = random() ^ (1 + 2 * (cfg.lbias / 100))
            A.lim = clamp(round(maxl - (maxl - mn) * u), mn, maxl)
            A.next_lim = A.cyc + random(2, 5)
        end
        lim = A.lim
    else
        lim = maxl
        A.lim = maxl
    end

    -- 4) разброс амплитуды модификатора
    if cfg.mrand and cfg.mod ~= "Spin" and cfg.mod ~= "Disabled" and cfg.amt > 0 then
        if A.hit_flag or A.cyc >= A.next_amt then
            local lo = max(0, floor(cfg.amt * 0.6))
            local hi = max(lo, min(90, floor(cfg.amt * 1.25)))
            A.amt_eff = random(lo, hi)
            A.next_amt = A.cyc + random(3, 7)
            if A.amt_eff ~= A.ap_amt then apply_modifier() end
        end
    elseif A.amt_eff then
        A.amt_eff = nil
        if A.ap_amt ~= cfg.amt then apply_modifier() end
    end
    A.hit_flag = false

    -- 5) defensive flick: ровно один цикл, потом возврат
    if cfg.def then
        if A.flick then
            end_flick()
        elseif tk >= A.next_flick then
            A.next_flick = tk + roll_period(max(cfg.def_ev, 2), 40)
            A.flick = true
            acall("override_pitch", random(0, 1) == 0 and -89 or 89)
            acall("override_yaw_offset", random(120, 180) * (random(0, 1) == 0 and -1 or 1))
        end
    else
        end_flick()
    end

    -- 6) отправляем только изменившееся
    if A.ap_inv ~= inv then A.ap_inv = inv; acall("override_inverter", inv) end
    if A.ap_lim ~= lim then A.ap_lim = lim; acall("override_desync_limits", lim, lim) end
end

local function reset_cache()
    A.ap_inv, A.ap_lim, A.ap_lag_en, A.ap_lag_lim = nil, nil, nil, nil
    A.ang_dirty, A.force_cycle = true, true
    A.cyc, A.since, A.stuck, A.own, A.ch_prev, A.ch_last = 0, 0, 0, 0, 0, nil
    A.next_flip, A.next_lim, A.next_flick = 0, 0, 0
    A.last_hp, A.hits_recent, A.panic_t, A.hit_t = nil, 0, 0, 0
    A.flick, A.tgt_bad, A.capped = false, 0, false
    A.next_amt, A.amt_eff, A.ap_amt, A.hit_flag = 0, nil, nil, false
end

local function aa_tick()
    local rt = clock()
    if rt >= A.cfg_t then load_cfg(); A.cfg_t = rt + 0.25 end

    if not cfg.en then
        if A.on then acall("reset"); A.on = false; reset_cache() end
        return
    end
    if not ME.alive then A.was_dead = true; return end        -- мёртв -> молчим
    if A.was_dead then A.was_dead = false; reset_cache() end  -- респавн -> всё заново

    local tk = globals.tickcount()
    if not A.on then A.on = true; reset_cache(); A.next_flick = tk + 24 end

    -- раз в 0.5 с принудительно переотправляем (движок мог сбросить overrides)
    if rt >= A.force_t then
        A.force_t = rt + 0.5
        A.ang_dirty = true
        A.ap_inv, A.ap_lim = nil, nil
    end
    if A.ang_dirty then apply_angles() end
    check_hit(rt)

    -- определяем начало нового цикла choke
    local lag_on = cfg.lag and cfg.lag_n >= 1
    local ch = acall("get_choked_ticks")
    local cyc = false
    if A.force_cycle then
        cyc, A.force_cycle = true, false
    elseif not lag_on then
        cyc = true
    elseif type(ch) == "number" then
        if ch == A.ch_last then A.stuck = A.stuck + 1 else A.stuck = 0 end
        A.ch_last = ch
        if A.stuck > 24 then                          -- счётчик движка завис -> считаем сами
            A.own = A.own + 1
            if A.own >= A.want then cyc, A.own = true, 0 end
        else
            A.own = 0
            cyc = (ch == 0) or (ch < A.ch_prev)
        end
    else
        A.own = A.own + 1
        if A.own >= A.want then cyc, A.own = true, 0 end
    end
    if type(ch) == "number" then A.ch_prev = ch; A.ch = floor(ch) end

    if cyc then new_cycle(rt, tk) else A.since = A.since + 1 end

    -- движок держит наш лимит? если нет (target больше нашего) - режем сами через unchoke
    if lag_on and A.since == 1 then
        local tgt = acall("get_choke_target")
        if type(tgt) == "number" then
            A.tgt = round(tgt)
            if abs(A.tgt - A.want) <= 1 then A.tgt_bad, A.capped = 0, false
            else
                A.tgt_bad = A.tgt_bad + 1
                if A.tgt_bad >= 4 then A.capped = (A.tgt > A.want) end
            end
        end
    end
    if lag_on and cfg.lag_cap and A.capped and A.ch >= A.want then acall("unchoke") end

    if rt >= A.tw_t then
        A.tw_t = rt + 0.4
        local tw = acall("get_twist_deg")
        A.tw = (type(tw) == "number") and round(tw) or nil
    end
end

TICKS[#TICKS + 1] = function()
    local ok, e = pcall(aa_tick)
    if not ok then A.err = string.sub(tostring(e), -90) end
end

HUDS[#HUDS + 1] = { name = "Anti-Aim", fn = function()
    if not cfg.en then return nil end
    local rows = {}
    rows[1] = { "Desync", round(A.lim) .. "°  real " .. (A.inv and "L" or "R") .. "  " .. cfg.mod .. " "
        .. tostring(A.ap_amt or cfg.amt) .. "°", COL.txt }
    local lag = "off"
    if cfg.lag and cfg.lag_n >= 1 then
        lag = cfg.lag_mode .. " " .. A.ch .. "/" .. A.want .. (A.capped and " cap" or "")
    end
    rows[2] = { "Lag", lag .. (A.tw and ("  tw " .. A.tw .. "°") or "") .. (A.flick and "  FLICK" or ""),
                A.flick and COL.warn or COL.txt }
    if flags ~= "" then rows[#rows + 1] = { "API", flags, COL.warn } end
    if A.err ~= "" then rows[#rows + 1] = { "ERR", A.err, COL.bad } end
    return { title = "ANTI-AIM", rows = rows }
end }

client.set_event_callback("round_start", function() if A.on then reset_cache() end end)
STOPS[#STOPS + 1] = function() acall("reset") end
