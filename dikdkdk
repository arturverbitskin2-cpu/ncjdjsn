do
local real_aa = aa
local FN, flags = {}, ""
local function flag(name, mark)
    local tag = " " .. name .. mark
    if not string.find(flags, tag, 1, true) then flags = flags .. tag end
end
local function acall(name, a, b)                    -- максимум 2 аргумента, без varargs
    local f = FN[name]
    if f == nil then
        f = real_aa[name]
        if type(f) ~= "function" then f = false end
        FN[name] = f
    end
    if not f then flag(name, "?") return nil end
    local ok, r
    if a == nil then ok, r = pcall(f)
    elseif b == nil then ok, r = pcall(f, a)
    else ok, r = pcall(f, a, b) end
    if not ok then flag(name, "!") return nil end
    return r
end

