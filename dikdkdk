-- ============================================================
do
local tab  = menu.new_tab("Smart Hitchance", ICON)
local sec  = tab:new_section("Hitchance", "Left")
local secS = tab:new_section("SSG 08", "Right")
local secD = tab:new_section("Deagle", "Right")

local U = {}
U.on     = T(sec, "Smart Hitchance (vs spread)", true)
U.good   = S(sec, "HC: stand + scoped", 0, 100, 62, 0, "%")
U.bad    = S(sec, "HC: moving / unscoped / air", 0, 100, 80, 0, "%")
U.speed  = S(sec, "Moving above speed", 1, 30, 8, 0, " st/s")
U.duck   = S(sec, "Crouch HC bonus", 0, 30, 8, 0, "%")
U.hoff   = S(sec, "Head HC offset", -20, 20, 5, 0, "%")
U.lethal = S(sec, "Lethal shot HC reduction", 0, 40, 20, 0, "%")
U.dynmp  = T(sec, "Head MP only if resolver confident", true)
U.mp_hc  = S(sec, "Head MP needs confidence >=", 0, 100, 30, 0, "%")

local function mkprof(s, tag, good, bad)
    local u = {}
    u.on   = T(s, tag .. " profile", true)
    u.good = S(s, tag .. " HC: stand + scoped", 0, 100, good, 0, "%")
    u.bad  = S(s, tag .. " HC: moving / unscoped / air", 0, 100, bad, 0, "%")
    u.mph  = T(s, tag .. " Multipoint head", true)
    u.mpb  = T(s, tag .. " Multipoint body", true)
    u.mdh  = S(s, tag .. " Min dmg head (0 = menu)", 0, 150, 0, 0, "")
    u.mdb  = S(s, tag .. " Min dmg body (0 = menu)", 0, 150, 0, 0, "")
    return u
end
local US = mkprof(secS, "SSG", 65, 82)
local UD = mkprof(secD, "Deagle", 58, 76)

local c = { on = true, good = 70, bad = 88, speed = 8, duck = 8, hoff = 5, lethal = 15,
            dynmp = true, mp_hc = 45, ssg = {}, dg = {} }
local HITBOXES = { "head", "chest", "pelvis", "arms", "legs" }
local H = { cur = nil, wid = nil, pkey = nil, txt = "menu", next_t = 0, force_t = 0, box_t = 0, cfg_t = 0,
            err = "", mph = nil, mpb = nil, head_off = false, info = nil, info_t = 0, lethal = false, mkey = nil }

local function load_prof(u, d)
    d.on   = u.on:get() and true or false
    d.good = u.good:get()
    d.bad  = u.bad:get()
    d.mph  = u.mph:get() and true or false
    d.mpb  = u.mpb:get() and true or false
    d.mdh  = u.mdh:get()
    d.mdb  = u.mdb:get()
end
local function load_cfg()
    c.on     = U.on:get() and true or false
    c.good   = U.good:get()
    c.bad    = U.bad:get()
    c.speed  = U.speed:get()
    c.duck   = U.duck:get()
    c.hoff   = U.hoff:get()
    c.lethal = U.lethal:get()
    c.dynmp  = U.dynmp:get() and true or false
    c.mp_hc  = U.mp_hc:get()
    load_prof(US, c.ssg)
    load_prof(UD, c.dg)
end

local function hb_off(hb)
    if hb == "head" then return c.hoff end
    return 0
end

local function apply(v, boxes)
    pcall(rage.override_hitchance, v)
    if boxes and rage.override_hitbox_hitchance then
        for i = 1, #HITBOXES do
            local hb = HITBOXES[i]
            pcall(rage.override_hitbox_hitchance, hb, clamp(v + hb_off(hb), 0, 100))
        end
    end
end

local function apply_prof(p, v)
    pcall(rage.override_hitchance, v)
    local list = { "head", "chest", "pelvis" }
    if rage.override_hitboxes then pcall(rage.override_hitboxes, list) end
    if rage.override_hitbox_priority then pcall(rage.override_hitbox_priority, { "head", "chest", "pelvis" }) end
    local mph, mpb = H.mph, H.mpb
    if mph == nil then mph = p.mph end
    if mpb == nil then mpb = p.mpb end
    if rage.set_hitbox_config then
        for i = 1, #list do
            local hb = list[i]
            local conf = { hitchance = clamp(v + hb_off(hb), 0, 100) }
            if hb == "head" then
                conf.multipoint = mph
                if p.mdh > 0 then conf.min_damage = p.mdh end
            else
                conf.multipoint = mpb
                if p.mdb > 0 then conf.min_damage = p.mdb end
            end
            pcall(rage.set_hitbox_config, hb, conf)
        end
    elseif rage.override_hitbox_hitchance then
        for i = 1, #list do
            pcall(rage.override_hitbox_hitchance, list[i], clamp(v + hb_off(list[i]), 0, 100))
        end
    end
end

local function pick_prof(w)
    local s = string.lower(tostring(w.name or "") .. " " .. tostring(w.id or ""))
    if string.find(s, "ssg", 1, true) or string.find(s, "scout", 1, true) then
        if c.ssg.on then return c.ssg, "SSG" end
    elseif string.find(s, "deagle", 1, true) or string.find(s, "desert", 1, true) then
        if c.dg.on then return c.dg, "DEAGLE" end
    end
    return nil, nil
end

local function compute()
    local w = weapon.get_active()
    if type(w) ~= "table" then return nil end
    local prof, pname = pick_prof(w)
    local t = 0
    local wt = string.lower(tostring(w.type or ""))
    if (string.find(wt, "sniper", 1, true) or pname == "SSG") and not weapon.is_scoped() then t = 1 end
    if movement.get_speed() > c.speed then t = 1 end
    if not movement.is_grounded() then t = 1 end
    local good, bad = c.good, c.bad
    if prof then good, bad = prof.good, prof.bad end
    local v = round(good + (bad - good) * t)
    if t < 1 and c.duck > 0 then
        local okd, dk = pcall(movement.is_ducking)
        if okd and dk then v = v - c.duck end
    end
    -- добивающий выстрел: ожидаемый урон >= HP цели -> HC можно ниже
    H.lethal = false
    if c.lethal > 0 then
        local okt, tg = pcall(rage.get_target)
        if okt and type(tg) == "table" and type(tg.damage) == "number" then
            local pl = tg.player or tg.entity or tg.target
            if pl ~= nil then
                local okh, hp = pcall(entity.get_player_health, pl)
                if okh and type(hp) == "number" and hp > 0 and tg.damage >= hp then
                    v = v - c.lethal
                    H.lethal = true
                end
            end
        end
    end
    return clamp(v, 0, 100), t, w, prof, pname
end

-- multipoint головы выключаем, пока резольвер не уверен в цели (гистерезис 5%)
local function calc_mp(prof, rt)
    local mph, mpb = prof.mph, prof.mpb
    if c.dynmp then
        local conf = 0.7
        local okt, tg = pcall(rage.get_target)
        if okt and type(tg) == "table" and SHARED.res_info then
            local oki, info = pcall(SHARED.res_info, tg)
            if oki and type(info) == "table" then H.info, H.info_t = info, rt end
        end
        if H.info and (rt - H.info_t) < 1.5 then conf = H.info.conf end
        local thr = c.mp_hc / 100
        if H.head_off then
            if conf >= thr + 0.05 then H.head_off = false end
        elseif conf < thr then
            H.head_off = true
        end
        if H.head_off then mph = false end
    else
        H.head_off = false
    end
    return mph, mpb
end

local function hc_tick()
    local rt = clock()
    if rt >= H.cfg_t then load_cfg(); H.cfg_t = rt + 0.25 end
    if rt < H.next_t then return end
    H.next_t = rt + 0.05

    if not c.on then
        if H.cur ~= nil then pcall(rage.reset); H.cur, H.wid, H.pkey, H.txt, H.v = nil, nil, nil, "menu", nil end
        return
    end
    if not ME.alive then return end

    local ok, v, t, w, prof, pname = pcall(compute)
    if not ok then H.txt = "err"; H.err = string.sub(tostring(v), -80) return end
    if v == nil then H.txt, H.v = "no weapon", nil return end
    H.err = ""

    local pkey = pname or "-"
    if pkey ~= H.pkey then
        if H.pkey ~= nil and H.pkey ~= "-" then pcall(rage.reset) end
        H.pkey, H.cur, H.wid, H.mkey, H.head_off = pkey, nil, nil, nil, false
    end

    local mchanged = false
    if prof then
        local mph, mpb = calc_mp(prof, rt)
        local mkey = tostring(mph) .. tostring(mpb)
        if mkey ~= H.mkey then mchanged = true; H.mkey = mkey; H.mph, H.mpb = mph, mpb end
    end

    local wid = w.id or w.name
    local changed = (v ~= H.cur) or (wid ~= H.wid) or mchanged
    if changed or rt >= H.force_t then
        H.cur, H.wid, H.force_t = v, wid, rt + 1
        local boxes = changed or rt >= H.box_t
        if boxes then H.box_t = rt + 3 end
        if prof then
            if boxes then apply_prof(prof, v) else pcall(rage.override_hitchance, v) end
        else
            apply(v, boxes)
        end
    end
    H.v, H.tq, H.pname = v, t, pname
    H.txt = "want " .. v .. (t >= 1 and " (bad)" or " (good)")
        .. (H.lethal and " | LETHAL" or "")
        .. (pname and (" | " .. pname .. " MP " .. (H.mph and "H" or "-") .. (H.mpb and "B" or "-")) or "")
end

TICKS[#TICKS + 1] = function()
    local ok, e = pcall(hc_tick)
    if not ok then H.err = string.sub(tostring(e), -80) end
end

