local c = { en = true }
local builtin_prev = nil
local function builtin_off()
    if builtin_prev == nil and rage.is_resolver_enabled and rage.set_resolver_enabled then
        local ok, cur = pcall(rage.is_resolver_enabled)
        if ok then
            builtin_prev = cur and true or false
            pcall(rage.set_resolver_enabled, false)
        end
    end
end
local function builtin_restore()
    if builtin_prev ~= nil then
        pcall(rage.set_resolver_enabled, builtin_prev)
        builtin_prev = nil
    end
end

