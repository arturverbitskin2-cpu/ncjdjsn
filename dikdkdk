-- ---------- обучение: gstats[kind][rel] = {h, s} (общий приор) + mem[id].stats (по врагу) ----------
local STATS_KEY = "hvh_lite_stats_v9"
local gstats = {}
do
    local ok, saved = pcall(function() return database.read(STATS_KEY) end)
    if ok and type(saved) == "table" then gstats = saved end
end
local mem = {}
local function save_stats()
    pcall(function() database.write(STATS_KEY, gstats); database.flush() end)
end

local KEY = setmetatable({}, { __index = function(t, k) local s = tostring(k); t[k] = s; return s end })
local function entry(tbl, kind, key)
    local kt = tbl[kind]
    if type(kt) ~= "table" then kt = {}; tbl[kind] = kt end
    local e = kt[key]
    if type(e) ~= "table" then e = { h = 0, s = 0 }; kt[key] = e end
    return e
end
local function credit(st, kind, rel, hit)
    local k = KEY[rel]
    local e = entry(st.m.stats, kind, k)
    e.s = e.s + 1
    if hit then e.h = e.h + 1 end
    if e.s > 30 then e.h = e.h * 0.5; e.s = e.s * 0.5 end
    local g = entry(gstats, kind, k)
    g.s = g.s + 1
    if hit then g.h = g.h + 1 end
    if g.s > 60 then g.h = g.h * 0.5; g.s = g.s * 0.5 end
end
local function score(st, kind, rel)
    local k = KEY[rel]
    local gk = gstats[kind]
    local g = gk and gk[k]
    local pg = g and ((g.h + 1) / (g.s + 2)) or 0.5
    local sk = st.m.stats[kind]
    local e = sk and sk[k]
    if not e then return pg end
    return (e.h + 2 * pg) / (e.s + 2)
end

-- ---------- кандидаты: числа умножаются на сторону desync врага ----------
local MEAS, MEAS_INV, MAXD, MAXDN, PRED, MID = 999, 998, 997, 996, 995, 994
local function needs_meas(r) return r == MEAS or r == MEAS_INV or r == PRED end
local ORDER = {
    static  = { MEAS, MAXD, MEAS_INV, 0, MAXDN, 86, -86, 58, -58, 30, -30 },
    flip    = { PRED, MEAS_INV, MEAS, MAXD, MAXDN, 0, 58, -58, 86, -86, 30, -30 },
    rand    = { MID, MAXD, MAXDN, MEAS, MEAS_INV, 0, 58, -58, 86, -86, 30, -30 },
    spin    = { MEAS, 0, MAXD, MAXDN, 86, -86, MEAS_INV, 58, -58, 30, -30 },
    unknown = { MEAS, MAXD, MEAS_INV, 0, MAXDN, 86, -86, 58, -58, 30, -30 },
}
local function rel_name(r)
    if r == MEAS then return "meas" end
    if r == MEAS_INV then return "-meas" end
    if r == MAXD then return "max" end
    if r == MAXDN then return "-max" end
    if r == PRED then return "pred" end
    if r == MID then return "mid" end
    return tostring(r)
end
local function rel_off(rel, side, st)
    if rel == MEAS then return st.meas or 0 end
    if rel == MEAS_INV then return -(st.meas or 0) end
    if rel == MAXD then return st.m.maxd * side end
    if rel == MAXDN then return -st.m.maxd * side end
    if rel == PRED then return st.pred_off or st.meas or 0 end
    if rel == MID then return st.m.mid * side end
    return rel * side
end
local function cand_norm(rel, st) return rel_off(rel, st.side, st) * st.side end

local function mark_tried(st, bk, rel)
    if rel == nil then return end
    bk.tried[rel] = true
    bk.tn[#bk.tn + 1] = cand_norm(rel, st)
end
local function clear_tried(bk)
    for k in pairs(bk.tried) do bk.tried[k] = nil end
    for i = #bk.tn, 1, -1 do bk.tn[i] = nil end
end
local function dup_tried(bk, st, rel)
    local v = cand_norm(rel, st)
    for i = 1, #bk.tn do
        if abs(bk.tn[i] - v) <= 3 then return true end
    end
    return false
end
local function pick(st, kind, bk, has_meas, retry)
    local list = ORDER[kind] or ORDER.unknown
    local best, best_score
    for i = 1, #list do
        local rel = list[i]
        if not bk.tried[rel] and (has_meas or not needs_meas(rel)) and not dup_tried(bk, st, rel) then
            local sc = score(st, kind, rel)
            if not best_score or sc > best_score + 1e-9 then best, best_score = rel, sc end
        end
    end
    if best == nil then                               -- все пробовали: новый круг, лучшим по статистике
        clear_tried(bk)
        if retry then
            if has_meas then return MEAS end
            return 0
        end
        return pick(st, kind, bk, has_meas, true)
    end
    return best
end

-- ---------- состояния врагов ----------
local FH = 12
local states, next_id = {}, 1
local fires, last_fire = {}, nil
local enemies, eids, ecount, present = {}, {}, 0, {}
local keymap = {}
local next_scan, next_cfg, last_tk = 0, 0, 0
local next_save = clock() + 60
local ev_n = { fire = 0, hit = 0, miss = 0, res = 0, spr = 0, spr_res = 0, occ = 0, dth = 0, unm = 0 }
local ev_last, unm_info = "-", ""
local dbg_log, diag = {}, { fire = 0, hit = 0, miss = 0 }
local active = false
local rerr, perr_txt, perr = "", "", {}

local function get_state(id)
    local st = states[id]
    if st then return st end
    local m = mem[id]
    if not m then m = { stats = {}, maxd = 58, mid = 58 }; mem[id] = m end
    st = {
        n = next_id, id = id, m = m,
        f = {}, e = {}, ey = nil, fy = nil, d = nil, same = 0,
        kind = "unknown", fkind = "unknown", ekind = "other",
        side = 1, meas = nil,
        buckets = {}, total_miss = 0, spread_streak = 0,
        mv = nil, rel = 0, off = 0, bkt = "Standing",
        hits = 0, shots = 0, def_until = 0, pc = {}, next_force = 0,
        runs = {}, rsign = nil, rt0 = 0, pred_off = nil, per = nil,
        name = nil, seen = clock(), dead = false,
    }
    next_id = next_id + 1
    states[id] = st
    return st
end

local function get_bucket(st, name)
    local b = st.buckets[name]
    if not b then
        b = { cur = nil, cur_kind = nil, tried = {}, tn = {}, step_miss = 0, good = nil, good_rel = nil }
        st.buckets[name] = b
    end
    return b
end

-- смерть / респавн / новый раунд: чистим только быструю историю. Рабочие углы (bk.good),
-- статистика, hits/shots, kind и maxd сохраняются -> новая жизнь начинается с известного угла.
local function reset_transient(st)
    st.f, st.e, st.runs = {}, {}, {}
    st.ey, st.fy, st.d, st.same = nil, nil, nil, 0
    st.fkind, st.ekind = "unknown", "other"
    st.meas, st.pred_off, st.per, st.rsign, st.rt0 = nil, nil, nil, nil, 0
    st.def_until, st.next_force, st.pc, st.mv = 0, 0, {}, nil
    st.total_miss, st.spread_streak = 0, 0
    for _, bk in pairs(st.buckets) do
        bk.step_miss, bk.cur, bk.cur_kind = 0, nil, nil
        clear_tried(bk)
    end
end
local function reset_all_transient()
    for _, st in pairs(states) do reset_transient(st) end
end

-- уверенность резольвера (0..1): тип AA, рабочий угол, статистика кандидата, промахи
local function conf_of(st, bk)
    local conf
    if bk and bk.good then
        conf = 0.9
        if st.shots >= 4 then conf = conf * (0.4 + 0.6 * (st.hits / st.shots)) end
    else
        local kind = st.kind
        if kind == "static" then conf = st.meas and 0.75 or 0.55
        elseif kind == "flip" then conf = st.pred_off and 0.6 or 0.35
        elseif kind == "rand" or kind == "spin" then conf = 0.3
        else conf = 0.45 end
        local sc = 0.5
        if st.rel ~= nil then sc = score(st, kind, st.rel) end
        conf = conf * (0.6 + 0.8 * sc) * (0.75 ^ st.total_miss)
    end
    return clamp(conf, 0, 1)
end

local function dbg(line)
    line = tostring(line)
    dbg_log[#dbg_log + 1] = line
    if #dbg_log > 5 then table.remove(dbg_log, 1) end
    print("[resolver] " .. line)
end

local function pset(en, st, key, val, force)
    local pc = st.pc
    if force or pc[key] ~= val then
        pc[key] = val
        if not pcall(plist.set, en, key, val) and not perr[key] then
            perr[key] = true
            perr_txt = perr_txt .. " [" .. key .. "]"
        end
    end
end

-- ---------- классификация ----------
-- по измеренному углу desync (feet - eye): static / flip (сторона прыгает) / rand
local function classify_fr(st)
    local f, n = st.f, #st.f
    if n < 4 then return "unknown" end
    local flips, steps = 0, 0
    for j = 2, n do
        local cur, prev = f[j], f[j - 1]
        if abs(cur) >= 12 and abs(prev) >= 12 then
            steps = steps + 1
            if (cur < 0) ~= (prev < 0) then flips = flips + 1 end
        end
    end
    if steps < 3 then return "static" end
    local ratio = flips / steps
    if ratio >= 0.5 then return "flip" end
    if ratio <= 0.15 then return "static" end
    return "rand"
end

-- по eye yaw: spin и defensive (разворот >120 за кадр после спокойного периода)
local function classify_eye(st)
    local e, n = st.e, #st.e
    if n < 6 then return "other", false end
    local sum, sum_abs, prev_abs, last_d = 0, 0, 0, 0
    for k = 2, n do
        local d = wrap(e[k] - e[k - 1])
        local ad = abs(d)
        if k < n then prev_abs = prev_abs + ad end
        sum, sum_abs, last_d = sum + d, sum_abs + ad, d
    end
    local cnt = n - 1
    local defensive = abs(last_d) > 120 and (prev_abs / (cnt - 1)) < 25
    local spin = (abs(sum) > sum_abs * 0.7) and (sum_abs / cnt) > 5
    return (spin and "spin" or "other"), defensive
end

-- ---------- предсказание стороны flip/jitter AA ----------
local function track_runs(st, mx, rt)
    if abs(mx) < 12 then return end
    local sg = (mx < 0) and -1 or 1
    if st.rsign == nil then
        st.rsign, st.rt0 = sg, rt
    elseif st.rsign ~= sg then
        local r = st.runs
        r[#r + 1] = rt - st.rt0
        if #r > 6 then table.remove(r, 1) end
        st.rsign, st.rt0 = sg, rt
    end
end

local function update_pred(st, rt)
    st.pred_off, st.per = nil, nil
    local r = st.runs
    local n = #r
    if n < 3 or not st.meas or st.rsign == nil then return end
    local lo, hi, sum, cnt = 1e9, 0, 0, 0
    for i = max(1, n - 3), n do
        local v = r[i]
        if v < lo then lo = v end
        if v > hi then hi = v end
        sum, cnt = sum + v, cnt + 1
    end
    if lo < 0.02 or hi > lo * 1.6 then return end     -- серии нерегулярные -> не предсказываем
    local per = sum / cnt
    st.per = per
    local lead = 0.06
    if client.latency then
        local ok, l = pcall(client.latency)
        if ok and type(l) == "number" then lead = clamp(l, 0.02, 0.25) end
    end
    local flips = floor(((rt - st.rt0) + lead) / per)
    local s = st.rsign
    if flips % 2 == 1 then s = -s end
    st.pred_off = s * abs(st.meas)
end

-- ---------- обработка одного врага ----------
local function push(arr, v, n)
    arr[#arr + 1] = v
    if #arr > n then table.remove(arr, 1) end
end

local function process(en, id, tk, rt)
    local st = states[id] or get_state(id)
    if not st.name then st.name = prop(en, "DisplayName") or prop(en, "Name") or tostring(id) end
    local anim = entity.get_anim_state(en)

    if anim then
        local ey, fy, d = anim.eye_angles_y, anim.goal_feet_yaw, anim.desync
        if type(d) ~= "number" then d = 0 end
        -- "пакет": eye yaw обновился либо ноги резко прыгнули. Плавное сглаживание в историю не пишем.
        local packet = false
        if type(ey) == "number" then
            if ey ~= st.ey then packet = true
            elseif type(fy) == "number" and st.fy and abs(wrap(fy - st.fy)) > 20 then packet = true end
        elseif d ~= st.d then
            packet = true
        end

        if packet or fy ~= st.fy or d ~= st.d then
            local fr = (type(ey) == "number" and type(fy) == "number") and wrap(fy - ey) or nil
            local mx
            if c.src == "Desync" then mx = d elseif c.src == "Feet" then mx = fr else mx = fr or d end

            if packet then
                if type(ey) == "number" and ey ~= st.ey then
                    push(st.e, ey, 16)
                    local ek, defensive = classify_eye(st)
                    st.ekind = ek
                    if defensive and c.def then st.def_until = tk + 14 end
                end
                if type(mx) == "number" then
                    push(st.f, mx, FH)
                    st.fkind = classify_fr(st)
                    track_runs(st, mx, rt)
                end
            end

            if type(mx) == "number" then
                if c.meas_on and abs(mx) >= 12 then
                    st.meas = clamp(mx, -86, 86)
                    local a = abs(st.meas)
                    if a > st.m.maxd then st.m.maxd = a else st.m.maxd = max(25, st.m.maxd * 0.999) end
                    st.m.mid = st.m.mid * 0.92 + a * 0.08
                else
                    st.meas = nil
                end
            end
            if st.meas then st.side = sgn(st.meas)
            elseif abs(d) > 6 then st.side = sgn(d) end

            st.ey, st.fy, st.d, st.same = ey, fy, d, 0
            if st.ekind == "spin" then st.kind = "spin"
            elseif st.fkind ~= "unknown" then st.kind = st.fkind end
        else
            st.same = st.same + 1
            if st.same >= 24 then st.kind = "static" end
        end
    end

    -- состояние движения раз в 4 тика
    if not st.mv or (tk + st.n) % 4 == 0 then
        local mvs = "All"
        if c.per_state then
            mvs = "Standing"
            if movement and movement.get_state then
                local ok, r = pcall(movement.get_state, en)
                if ok and r then mvs = r end
            end
        end
        st.mv = mvs
    end

    if c.pred and st.kind == "flip" then update_pred(st, rt) else st.pred_off, st.per = nil, nil end

    -- выбор угла: рабочий (который попал) -> иначе лучший по статистике
    local bk = get_bucket(st, st.mv)
    local has_meas = st.meas ~= nil
    local rel
    if bk.good then
        rel = bk.good_rel or 0
    else
        if bk.cur and needs_meas(bk.cur) and not has_meas then bk.cur = nil end
        if not bk.cur or (bk.cur_kind ~= st.kind and bk.step_miss == 0 and next(bk.tried) == nil) then
            bk.cur, bk.cur_kind = pick(st, st.kind, bk, has_meas), st.kind
        end
        rel = bk.cur
    end
    local off = round(rel_off(rel, st.side, st))
    st.rel, st.off, st.bkt = rel, off, st.mv

    local force = false
    if rt >= st.next_force then force = true; st.next_force = rt + 0.5 + (st.n % 5) * 0.1 end

    -- как в примере из доки: Force body yaw + offset каждый тик
    pset(en, st, "Force body yaw", true, true)
    pset(en, st, "Override yaw offset", off, true)

    -- политика: против нестабильного AA и при низкой уверенности меняем урон на гарантию попадания
    local kd = st.kind
    local hardk  = (kd == "flip" or kd == "rand" or kd == "spin")
    local proven = bk.good ~= nil and st.hits * 2 >= st.shots          -- рабочий угол + нормальный % попаданий
    local hard = c.smart_baim and hardk and st.shots >= 3 and st.hits * 3 < st.shots
    local baim = st.total_miss >= c.baim or tk < st.def_until or hard
    pset(en, st, "Override prefer body aim", baim and "Force" or "-", force)
    local sp = st.total_miss >= c.baim + 1
    if c.sp_hard and not sp and hardk and not proven then sp = true end
    if c.sp_conf > 0 and not sp and not proven and conf_of(st, bk) * 100 < c.sp_conf then sp = true end
    pset(en, st, "Override safe point", sp and "Force" or "-", force)

    if c.pitch then
        pset(en, st, "Force pitch", true, force)
        pset(en, st, "Force pitch value", 89, force)
    else
        pset(en, st, "Force pitch", false, force)
    end
end

-- ---------- список врагов + таблица идентификаторов ----------
local function index_enemy(e, id)
    keymap[e] = id
    keymap[id] = id
    local n = prop(e, "Name")
    if n ~= nil then keymap[n] = id; keymap[string.lower(tostring(n))] = id end
    local dn = prop(e, "DisplayName")
    if dn ~= nil then keymap[string.lower(tostring(dn))] = id end
    local u = prop(e, "UserId")
    if u ~= nil then keymap[u] = id end
    local ch = prop(e, "Character")
    if ch ~= nil then keymap[ch] = id end
    local s = get_slot(e)
    if s ~= nil then keymap[s] = id end
end

local function scan()
    local list = entity.get_enemies()
    if type(list) ~= "table" then return end
    local n = 0
    for k in pairs(present) do present[k] = nil end
    for i = 1, #list do
        local e = list[i]
        if entity.is_alive(e) then
            local id = sid_of(e)
            n = n + 1
            enemies[n], eids[n] = e, id
            present[id] = true
            index_enemy(e, id)
        end
    end
    for i = n + 1, ecount do enemies[i], eids[i] = nil, nil end
    ecount = n
    local now = clock()
    for id, st in pairs(states) do
        if present[id] then
            st.seen, st.dead = now, false
        else
            if not st.dead then st.dead = true; reset_transient(st) end
            if now - (st.seen or now) > 180 then states[id] = nil end   -- ушёл с сервера
        end
    end
end

local function resolver_tick()
    local rt = clock()
    if rt >= next_cfg then load_cfg(); next_cfg = rt + 0.25 end

    if not c.en then
        if active then
            plist.reset_all()
            states, fires, last_fire = {}, {}, nil
            builtin_restore()
            active = false
        end
        return
    end
    active = true

    local tk = globals.tickcount()
    if tk < last_tk then reset_all_transient(); fires, last_fire, next_scan = {}, nil, 0 end
    last_tk = tk

    if rt >= next_scan then scan(); next_scan = rt + 0.25 end
    if c.learn and rt >= next_save then next_save = rt + 60; save_stats() end

    for i = 1, ecount do
        local ok, e = pcall(process, enemies[i], eids[i], tk, rt)
        if not ok then rerr = string.sub(tostring(e), -90) end
    end
end

TICKS[#TICKS + 1] = function()
    local ok, e = pcall(resolver_tick)
    if not ok then rerr = string.sub(tostring(e), -90) end
end

-- ---------- события выстрелов: цель ищем ВСЕМИ способами ----------
local LOOK = { "slot", "player", "entity", "target", "Name", "name", "UserId", "userid", "index", "id", "Parent", "Character" }

local function lookup(t)
    if t == nil then return nil end
    local id = keymap[t]
    if id ~= nil then return id end
    local tt = type(t)
    if tt == "string" then return keymap[string.lower(t)] end
    if tt == "number" or tt == "boolean" then return nil end
    for i = 1, #LOOK do                               -- таблица / Instance: типичные поля
        local v = prop(t, LOOK[i])
        if v ~= nil and v ~= t then
            id = keymap[v]
            if id == nil and type(v) == "string" then id = keymap[string.lower(v)] end
            if id ~= nil then return id end
        end
    end
    return nil
end

local function nearest(pt)                            -- враг, ближайший к точке прицеливания
    local best, bd = nil, 15
    for i = 1, ecount do
        local ok, pos = pcall(entity.get_player_position, enemies[i])
        if ok and pos ~= nil then
            local ok2, dd = pcall(function() return (pos - pt).Magnitude end)
            if ok2 and type(dd) == "number" and dd < bd then best, bd = eids[i], dd end
        end
    end
    return best
end

local function find_id(e)
    local id = lookup(e.target)
    if id == nil then scan(); id = lookup(e.target) end          -- возможно, список устарел
    if id == nil and e.point ~= nil then id = nearest(e.point) end
    if id == nil then
        local ok, t = pcall(rage.get_target)
        if ok and t ~= nil then id = lookup(t) end
    end
    if id == nil and ecount == 1 then id = eids[1] end
    return id
end

local function ev(a, b, cc)                           -- понимаем и таблицу e, и позиционные аргументы
    if type(a) == "table" then
        local t = prop(a, "target")
        if t ~= nil then return a end
        if prop(a, "id") ~= nil then return a end
    end
    return { target = a, hitbox = b, reason = (type(cc) == "string") and cc or nil }
end

local function diag_log(kind, e)                      -- первые 3 события каждого вида: что именно приходит
    if diag[kind] >= 3 then return end
    diag[kind] = diag[kind] + 1
    local t = e.target
    print("[resolver] diag " .. kind .. ": target=" .. type(t) .. ":" .. tostring(t) .. " id=" .. tostring(e.id)
        .. " reason=" .. tostring(e.reason) .. " hitbox=" .. tostring(e.hitbox))
end

local function note_unm(kind, e)                     -- что именно не нашлось (виден на HUD)
    ev_n.unm = ev_n.unm + 1
    unm_info = kind .. " t=" .. type(e.target) .. ":" .. tostring(e.target) .. " id=" .. tostring(e.id)
        .. " r=" .. tostring(e.reason)
end

-- состояние + запись о выстреле для hit / miss
local function shot_for(e)
    local f = nil
    if e.id ~= nil then f = fires[e.id]; fires[e.id] = nil end
    local st = f and f.st
    if not st then
        local id = find_id(e)
        st = id ~= nil and states[id] or nil
        if not st then
            -- цель события не опознана: берём наш последний выстрел (результат приходит сразу за ним)
            if last_fire and clock() - last_fire.t < 3 then f = last_fire; st = f.st
            else return nil, nil end
        end
    end
    if not f and last_fire and last_fire.st == st then f = last_fire end
    if f == last_fire then last_fire = nil end
    if not f then f = { st = st, rel = st.rel, off = st.off, kind = st.kind, bkt = st.bkt, t = clock() } end
    return st, f
end

client.set_event_callback("aim_fire", function(a, b, cc)
    local e = ev(a, b, cc)
    ev_n.fire = ev_n.fire + 1
    diag_log("fire", e)
    local id = find_id(e)
    local st = id ~= nil and states[id] or nil
    if not st then note_unm("fire", e) return end
    st.shots = st.shots + 1
    if st.shots > 24 then st.shots, st.hits = st.shots * 0.5, st.hits * 0.5 end
    local hc = e.hitchance
    if type(hc) == "number" then
        if hc <= 0 then hc = nil elseif hc <= 1 then hc = hc * 100 end
    end
    local now = clock()
    local f = { st = st, rel = st.rel, off = st.off, kind = st.kind, bkt = st.bkt, hc = hc, t = now }
    if e.id ~= nil then
        fires[e.id] = f
        for k, old in pairs(fires) do                 -- чистим потерянные выстрелы
            if now - old.t > 6 then fires[k] = nil end
        end
    end
    last_fire = f
    if c.dbg then
        dbg("fire kind=" .. st.kind .. " rel=" .. rel_name(st.rel) .. " off=" .. st.off
            .. " meas=" .. tostring(st.meas and round(st.meas)) .. " hc=" .. tostring(hc and round(hc)))
    end
end)

client.set_event_callback("aim_hit", function(a, b, cc)
    local e = ev(a, b, cc)
    ev_n.hit = ev_n.hit + 1
    diag_log("hit", e)
    local st, f = shot_for(e)
    if not st then note_unm("hit", e) return end
    local bk = get_bucket(st, f.bkt or st.bkt)
    st.hits = st.hits + 1
    st.spread_streak = 0
    credit(st, f.kind, f.rel, true)
    bk.good, bk.good_rel, bk.step_miss = f.off, f.rel, 0
    clear_tried(bk)
    if c.reset_hit then st.total_miss = 0 end
    if c.dbg then dbg("HIT kind=" .. f.kind .. " rel=" .. rel_name(f.rel) .. " off=" .. f.off) end
end)

client.set_event_callback("aim_miss", function(a, b, cc)
    local e = ev(a, b, cc)
    ev_n.miss = ev_n.miss + 1
    diag_log("miss", e)
    ev_last = tostring(e.reason)
    local st, f = shot_for(e)
    if not st then note_unm("miss", e) return end

    -- reason по доке: "resolver" | "spread" | "occlusion" | "death". Нет причины - считаем resolver.
    local r = e.reason and string.lower(tostring(e.reason)) or ""
    if string.find(r, "occlu", 1, true) then ev_n.occ = ev_n.occ + 1 return end
    if string.find(r, "death", 1, true) or string.find(r, "dead", 1, true) then ev_n.dth = ev_n.dth + 1 return end
    if string.find(r, "spread", 1, true) then
        ev_n.spr = ev_n.spr + 1
        -- движок часто пишет "spread" на промахи резольвера: высокий HC выстрела или 2-й подряд -> наказываем
        local count = false
        if c.spr_res then
            local bk0 = get_bucket(st, f.bkt or st.bkt)
            if bk0.good then count = st.spread_streak >= 1
            elseif f.hc == nil or f.hc >= c.spr_hc or st.spread_streak >= 1 then count = true end
        end
        if not count then
            st.spread_streak = st.spread_streak + 1
            if c.dbg then dbg("miss(spread, ignored)") end
            return
        end
        ev_n.spr_res = ev_n.spr_res + 1
    end
    ev_n.res = ev_n.res + 1
    st.spread_streak = 0

    local bk = get_bucket(st, f.bkt or st.bkt)
    credit(st, f.kind, f.rel, false)
    st.total_miss = st.total_miss + 1
    bk.step_miss = bk.step_miss + 1
    if c.dbg then
        dbg("MISS(" .. r .. ") kind=" .. f.kind .. " rel=" .. rel_name(f.rel) .. " off=" .. f.off .. " total=" .. st.total_miss)
    end

    if bk.good then                                   -- у рабочего угла запас на 1 промах
        if bk.step_miss >= c.step + 1 then
            mark_tried(st, bk, bk.good_rel)
            bk.good, bk.good_rel, bk.step_miss, bk.cur = nil, nil, 0, nil
        end
    elseif bk.step_miss >= c.step then
        mark_tried(st, bk, f.rel or bk.cur)
        bk.step_miss, bk.cur = 0, nil
    end
end)

client.set_event_callback("round_start", function()
    reset_all_transient()
    fires, last_fire, next_scan = {}, nil, 0
