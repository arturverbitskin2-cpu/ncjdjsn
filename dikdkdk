end)

local FONT = (Drawing.Fonts and Drawing.Fonts.Plex) or 2
local C_BG, C_LINE, C_TRACK, C_BORDER = color(13, 15, 23), color(38, 43, 62), color(34, 38, 54), color(52, 58, 84)
local C_G1, C_G2 = color(66, 88, 232), color(132, 72, 220)

-- постоянные объекты: фон, шапка, индикатор статуса
local bg, hdr, dot = Drawing.new("Square"), Drawing.new("Square"), Drawing.new("Circle")
pcall(function()
    bg.Filled, hdr.Filled, dot.Filled = true, true, true
    bg.ZIndex, hdr.ZIndex, dot.ZIndex = 10, 11, 14
    dot.Radius = 4
end)
bg.Visible, hdr.Visible, dot.Visible = false, false, false

-- пул текстов и прямоугольников (бары, разделители, метки секций)
local TXT, SQR = {}, {}
local nt, nq = 0, 0

local function T()
    nt = nt + 1
    local o = TXT[nt]
    if not o then
        o = Drawing.new("Text")
        pcall(function() o.Font = FONT; o.Outline = false; o.ZIndex = 13 end)
        TXT[nt] = o
    end
    o.Visible = true
    return o
end

local function Q()
    nq = nq + 1
    local o = SQR[nq]
    if not o then
        o = Drawing.new("Square")
        pcall(function() o.Filled = true; o.ZIndex = 12 end)
        SQR[nq] = o
    end
    o.Visible = true
    return o
end

local function settx(o, str, x, y, size, col)
    o.Text, o.Size, o.Position, o.Color = str, size, vector(x, y), col
end

local function setsq(o, x, y, w, h, col, a, rnd)
    o.Position, o.Size, o.Color = vector(x, y), vector(w, h), col
    o.Transparency, o.Rounding = a, rnd
end

local function tw(str, size)                          -- ширина текста (фолбэк - эвристика)
    local ok, v = pcall(render.measure_text, str, size, FONT)
    if ok and v ~= nil then
        local w = v.X
        if type(w) == "number" then return w end
    end
    return #str * size * 0.56
end

local function layout(secs, x, y, sz, alpha, alive)
    nt, nq = 0, 0
    local pad  = round(sz * 0.8)
    local rowh = sz + 5
    local labw = round(sz * 5.8)
    local W    = round(sz * 26)
    local hh   = sz + 16
    local lx0  = x + pad + 9
    local vw   = W - pad * 2 - 9 - labw
    local maxc = max(8, floor(vw / (sz * 0.56)))
    local barw = floor(vw * 0.55)

    -- шапка: градиент + название + статус
    setsq(hdr, x, y, W, hh, C_G1, alpha, 8)
    hdr.Visible = true
    pcall(function() hdr.Gradient = { Color1 = C_G1, Color2 = C_G2, Angle = 0 } end)
    local ty = y + floor((hh - sz) / 2) - 1
    local title = T(); settx(title, "HVH LITE", x + pad, ty, sz + 1, COL.txt)
    local ver = T();   settx(ver, "v9.1", x + pad + tw("HVH LITE", sz + 1) + 6, ty + 1, sz - 1, color(230, 234, 255))
    local stxt = alive and "ALIVE" or "DEAD"
    local st = T();    settx(st, stxt, x + W - pad - 13 - tw(stxt, sz - 1), ty + 1, sz - 1, COL.txt)
    dot.Position, dot.Color, dot.Visible = vector(x + W - pad - 4, y + floor(hh / 2)), alive and COL.ok or COL.bad, true

    -- секции
    local cy = y + hh + 8
    for si = 1, #secs do
        local s = secs[si]
        if si > 1 then
            setsq(Q(), x + pad, cy - 3, W - pad * 2, 1, C_LINE, 1, 0)
            cy = cy + 3
        end
        setsq(Q(), x + pad, cy + 2, 3, sz - 3, COL.acc, 1, 1)
        settx(T(), s.title, x + pad + 9, cy, sz - 1, COL.dim)
        cy = cy + rowh

        local rows = s.rows
        for ri = 1, #rows do
            local r = rows[ri]
            local lbl, val, col, bar = r[1], tostring(r[2] or ""), r[3] or COL.txt, r[4]
            local vx = lx0 + labw
            if lbl and lbl ~= "" then settx(T(), lbl, lx0, cy, sz, COL.dim) end
            if bar then
                local by = cy + floor(sz / 2) - 1
                setsq(Q(), vx, by, barw, 5, C_TRACK, 1, 2)
                setsq(Q(), vx, by, max(3, floor(barw * clamp(bar, 0, 1))), 5, col, 1, 2)
                settx(T(), val, vx + barw + 6, cy, sz, col)
                cy = cy + rowh
            else
                local rest = val
                repeat                                  -- длинное значение переносим по пробелам
                    local cut = maxc
                    if #rest > maxc then
                        for k = maxc, floor(maxc * 0.5), -1 do
                            if string.byte(rest, k) == 32 then cut = k; break end
                        end
                    else
                        cut = #rest
                    end
                    settx(T(), string.sub(rest, 1, cut), vx, cy, sz, col)
                    cy = cy + rowh
                    rest = string.gsub(string.sub(rest, cut + 1), "^%s+", "")
                until rest == ""
            end
        end
        cy = cy + 3
    end

    -- фон под всё
    setsq(bg, x, y, W, cy - y + 2, C_BG, alpha, 8)
    bg.Visible = true
    pcall(function() bg.BorderColor = C_BORDER end)

    for i = nt + 1, #TXT do TXT[i].Visible = false end
    for i = nq + 1, #SQR do SQR[i].Visible = false end
end

local h_next, h_sig, h_vis, h_err = 0, "", false, false
local function hide_all()
    if not h_vis then return end
    h_vis, h_sig = false, ""
    bg.Visible, hdr.Visible, dot.Visible = false, false, false
    for i = 1, #TXT do TXT[i].Visible = false end
    for i = 1, #SQR do SQR[i].Visible = false end
end

client.set_event_callback("paint", function()
    if not U.master:get() then hide_all(); return end
    local rt = clock()
    if rt < h_next then return end
    h_next = rt + 0.15

    local secs, n = {}, 0
    for i = 1, #HUDS do
        if show[i]:get() then
            local ok, s = pcall(HUDS[i].fn)
            if ok and s then n = n + 1; secs[n] = s end
        end
    end
    if n == 0 then hide_all(); return end

    local x, y, sz, al = floor(U.x:get()), floor(U.y:get()), floor(U.size:get()), U.alpha:get() / 100
    local alive = ME.alive and true or false

    local sg = { x, y, sz, al, tostring(alive) }
    local m = #sg
    for i = 1, n do
        local s = secs[i]
        m = m + 1; sg[m] = s.title
        for j = 1, #s.rows do
            local r = s.rows[j]
            m = m + 1
            sg[m] = tostring(r[1]) .. "\2" .. tostring(r[2]) .. "\2" .. tostring(r[3]) .. "\2" .. tostring(r[4] and floor(r[4] * 100) or "")
        end
    end
    local sig = table.concat(sg, "\1")
    if sig == h_sig and h_vis then return end
    h_sig, h_vis = sig, true

    local ok, e = pcall(layout, secs, x, y, sz, al, alive)
    if not ok and not h_err then h_err = true; print("[hvh] hud layout error: " .. tostring(e)) end
end)

-- единственный on_tick: AA -> Resolver -> HC
events.on_tick(function()
    update_me(clock())
    for i = 1, #TICKS do TICKS[i]() end
end)

client.set_event_callback("shutdown", function()
    for i = 1, #STOPS do pcall(STOPS[i]) end
    for i = 1, #TXT do pcall(function() TXT[i]:Destroy() end) end
    for i = 1, #SQR do pcall(function() SQR[i]:Destroy() end) end
    pcall(function() bg:Destroy(); hdr:Destroy(); dot:Destroy() end)
    render.clear()
end)

print("[hvh] lite v9.1 loaded")
if notify then notify("HVH Lite v9.1", "AA + Resolver + Smart HC loaded", 2, false) end
end -- PART 4
