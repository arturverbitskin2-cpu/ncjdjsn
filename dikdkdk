local ME = { alive = true, t = 0, me = nil, spawn = false }
local function update_me(rt)
    if rt < ME.t then return end
    ME.t = rt + 0.1
    local me = entity.get_local_player()
    ME.me = me
    if me == nil then ME.alive = true return end
    local ok, a = pcall(entity.is_alive, me)
    local alive = (not ok) or (a ~= false)
    if alive and not ME.alive then ME.spawn = true end
    ME.alive = alive
end


