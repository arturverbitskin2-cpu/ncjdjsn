local floor, abs, max, min, random = math.floor, math.abs, math.max, math.min, math.random
local sin = math.sin

local function wrap(a) return ((a + 180) % 360) - 180 end
local function sgn(x) if x < 0 then return -1 end return 1 end
local function round(x) return floor(x + 0.5) end
local function clamp(x, lo, hi)
    if x < lo then return lo elseif x > hi then return hi end
    return x
end
local function prop(o, name)                       -- безопасное чтение поля (Instance кидает ошибку на чужое поле)
    local ok, v = pcall(function() return o[name] end)
    if ok then return v end
    return nil
end

